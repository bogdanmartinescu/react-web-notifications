{
	"name": "react-web-notifications",
	"version": "2.0.0",
	"description": "Simple web notifications component for React",
	"files": [
		"dist"
	],
	"sideEffects": false,
	"scripts": {
		"build": "tsdown",
		"lint": "oxlint --deny-warnings",
		"typecheck": "tsc",
		"test": "vitest run",
		"prepack": "npm run build"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bogdanmartinescu/react-web-notifications.git"
	},
	"homepage": "https://github.com/bogdanmartinescu/react-web-notifications",
	"bugs": "https://github.com/bogdanmartinescu/react-web-notifications/issues",
	"author": "Bogdan M <hi@mlb.ro> (http://mlb.ro/)",
	"license": "MIT",
	"peerDependencies": {
		"react": "^17.0.0 || ^18.0.0 || ^19.0.0"
	},
	"keywords": [
		"react",
		"web-notification",
		"notification",
		"html5 notifications"
	],
	"devDependencies": {
		"@arethetypeswrong/core": "^0.18.5",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/react": "^16.3.3",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"jsdom": "^31.0.1",
		"oxlint": "^1.94.0",
		"publint": "^0.3.25",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"tsdown": "^0.23.7",
		"typescript": "^7.0.2",
		"vitest": "^5.1.1"
	},
	"main": "./dist/react-web-notifications.js",
	"module": "./dist/react-web-notifications.mjs",
	"types": "./dist/react-web-notifications.d.ts",
	"exports": {
		".": {
			"import": "./dist/react-web-notifications.mjs",
			"require": "./dist/react-web-notifications.js"
		},
		"./package.json": "./package.json",
		"./dist/react-web-notifications.js": "./dist/react-web-notifications.js",
		"./dist/react-web-notifications.es.js": "./dist/react-web-notifications.mjs"
	},
	"type": "commonjs"
}
